# For local Wrangler development, copy this file to .dev.vars
# Leave OIDC values blank to use the username and password form.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_CLIENT_AUTH=client_secret_basic
OIDC_LABEL=OIDC 单点登录
OIDC_REDIRECT_URI=

# Optional administrator identities, matched only to their specific login method.
ZXP_ADMIN_CHATGPT_EMAIL=
ZXP_ADMIN_LOCAL_USER_ID=
ZXP_ADMIN_OIDC_SUB=

# Optional deployment override. Comma-separated chatgpt,password,oidc.
# Use oidc for OIDC-only. Leave blank to manage the switches at /admin.
ZXP_LOGIN_METHODS=
